# Application
MODELLYNG_ENVIRONMENT=development
MODELLYNG_ALLOWED_ORIGINS=["http://localhost:8081","http://localhost:3000","http://127.0.0.1:3000"]

# Redis / Celery (started with `docker compose up -d` from the repo root)
MODELLYNG_REDIS_URL=redis://localhost:6380/0
MODELLYNG_ENQUEUE_JOBS=true

# Local Supabase (copy the keys printed by `supabase status`)
MODELLYNG_SUPABASE_URL=http://127.0.0.1:18021
MODELLYNG_SUPABASE_ANON_KEY=your_supabase_anon_key_here
MODELLYNG_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
MODELLYNG_OBJECT_STORAGE_BUCKET=private-papers

# Gemini API free-tier key; never expose this value in Flutter
GEMINI_API_KEY=your_gemini_api_key_here
MODELLYNG_GEMINI_MODEL=gemini-flash-latest
MODELLYNG_GEMINI_MAX_INPUT_CHARS=400000
